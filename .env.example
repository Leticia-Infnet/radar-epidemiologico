# Copie para .env e preencha. Nunca versione o .env.
# No GitHub Actions, cadastre os mesmos nomes em Settings > Secrets and variables.
# No Streamlit Community Cloud, em Settings > Secrets, no formato TOML
# (RADAR_LLM_API_KEY = "..."); chaves de nível raiz viram variáveis de ambiente.

RADAR_HF_TOKEN=
RADAR_HF_DATASET_REPO=LeticiaF/radar-epidemiologico-dados
# Chave gratuita do Groq (console.groq.com), usada pelo chatbot.
RADAR_LLM_API_KEY=
# Token fine-grained com escrita só no dataset privado de consultas do chatbot.
RADAR_HF_CONSULTAS_TOKEN=
